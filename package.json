{
  "name": "deepseek-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial desktop launcher and lifecycle manager for DeepSeek Harness.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/build-tauri.mjs",
    "tauri:build:dmg": "node scripts/build-dmg.mjs",
    "tauri:build:binary": "tauri build --no-bundle"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
